# ---- API ----
NODE_ENV=development
API_HOST=::
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- Database / Supabase ----
# Supabase > Connect > Direct > Session pooler (IPv4-friendly). URL-encode special characters.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10
# Vercel production builds migrate through this (session pooler, port 5432) before going live;
# DATABASE_URL there is the transaction pooler (port 6543), which can't run migrations.
# MIGRATE_DATABASE_URL=
# Optional: separate database for automated tests (defaults to DATABASE_URL; tests roll back).
# DATABASE_URL_TEST=

# ---- API hardening ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=300
# Set true only behind a trusted proxy/load balancer (uses X-Forwarded-For for client IPs)
TRUST_PROXY=false
# Enables GET /internal/metrics (send as x-metrics-token header); 16+ random characters
# METRICS_TOKEN=

# ---- Outbox worker (npm run dev:worker) ----
PUBLIC_SITE_URL=http://localhost:3000
# Without RESEND_API_KEY emails are logged instead of sent
# RESEND_API_KEY=
EMAIL_FROM=Ohviana <bookings@example.com>
# ADMIN_NOTIFY_EMAIL=

# ---- Auth (Supabase) ----
# Access tokens are verified against this project's public signing keys (JWKS); no secret needed.
SUPABASE_URL=https://<project-ref>.supabase.co

# ---- Login mode ----
# 'supabase' accepts Supabase tokens plus Ohviana's own sessions (AUTH_JWT_SECRET below);
# 'dev' adds a password-less local testing login (refused in production).
AUTH_MODE=supabase
# Signs email + password session tokens: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=

# Customer sign-in: an SMS code at checkout (needs AUTH_JWT_SECRET). Only `log` for now: the
# code is printed in the API log instead of being texted. Connect a real SMS provider before launch.
SMS_PROVIDER=log
# Testing only (e2e needs it): every sign-in code is this value. Refused in production.
# OTP_DEV_CODE=123456
