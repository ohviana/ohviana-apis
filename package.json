{
  "name": "ohviana-apis",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ohviana/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:migrate": "npm run db:migrate -w @ohviana/db",
    "db:seed": "npm run db:seed -w @ohviana/db",
    "db:generate": "npm run db:generate -w @ohviana/db",
    "db:studio": "npm run db:studio -w @ohviana/db",
    "admin:grant": "npm run admin:grant -w @ohviana/db --",
    "dev:worker": "npm run dev:worker -w @ohviana/api",
    "user:set-password": "npm run user:set-password -w @ohviana/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
