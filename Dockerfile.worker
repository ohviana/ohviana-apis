# Outbox worker (emails, maintenance, seat reconciliation) as a Vercel Daemon; see vercel.json.
# Lives at the repository root because a daemon's build context is the Dockerfile's folder and
# the build needs the whole workspace. Same build as apps/api/Dockerfile, different command.
#   docker build -f Dockerfile.worker -t ohviana-worker . && docker run --env-file .env ohviana-worker

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace @ohviana/api --include-workspace-root
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/api apps/api
RUN npm run build -w @ohviana/api

FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/apps/api/package.json apps/api/
COPY --from=build /app/packages/contracts/package.json packages/contracts/
COPY --from=build /app/packages/db/package.json packages/db/
COPY --from=build /app/packages/shared/package.json packages/shared/
# Runtime needs only the API's npm dependencies; workspace code is bundled into dist/.
RUN npm ci --omit=dev --workspace @ohviana/api --ignore-scripts

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
USER node
CMD ["node", "dist/worker/main.js"]
