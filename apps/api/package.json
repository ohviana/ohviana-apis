{
  "name": "@ohviana/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker/main.ts",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker/main.js",
    "user:set-password": "tsx --env-file-if-exists=../../.env src/cli/set-password.ts",
    "seed:photos": "tsx --env-file-if-exists=../../.env src/cli/seed-photos.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@ohviana/contracts": "0.0.0",
    "@ohviana/db": "0.0.0",
    "@ohviana/shared": "0.0.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
